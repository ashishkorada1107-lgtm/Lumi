# Supabase Client Variables (Must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server Variable (Keep Secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push Client Variable
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Web Push Server Variables (Keep Secret)
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com

# Vercel Cron Authentication (Keep Secret)
# Automatically provided by Vercel in production if you use Vercel Cron.
# Set this manually for local testing.
CRON_SECRET=your-cron-secret

